<UserControl x:Class="ServiceManagerApp.Frontend.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ServiceManagerApp.Frontend"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="900"
             d:Background="White">
    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
        </Style>

        <Style x:Key="SectionNote" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#777777"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
        </Style>

        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,10"/>
        </Style>

        <Style x:Key="TileLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="TileNumber" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="ListFrame" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>

        <Style x:Key="HeaderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#555555"/>
        </Style>

        <Style x:Key="EmptyText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="Margin" Value="12,10"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>

        <!-- Keresés közben eltűnik -->
        <Style x:Key="NormalLists" TargetType="StackPanel">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ShowSearchResults}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Csak keresés közben látszik -->
        <Style x:Key="SearchSection" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ShowSearchResults}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="#EEEEEE"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Diagnosing">
                    <Setter Property="Background" Value="#E6F1FB"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="InRepair">
                    <Setter Property="Background" Value="#FAEEDA"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Finished">
                    <Setter Property="Background" Value="#EAF3DE"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="HandedOver">
                    <Setter Property="Background" Value="#F1EFE8"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                    <Setter Property="Background" Value="#FCEBEB"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Text" Value="Accepted"/>
            <Setter Property="Foreground" Value="#444444"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Diagnosing">
                    <Setter Property="Text" Value="Diagnosing"/>
                    <Setter Property="Foreground" Value="#0C447C"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="InRepair">
                    <Setter Property="Text" Value="In repair"/>
                    <Setter Property="Foreground" Value="#633806"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Finished">
                    <Setter Property="Text" Value="Finished"/>
                    <Setter Property="Foreground" Value="#27500A"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="HandedOver">
                    <Setter Property="Text" Value="Handed over"/>
                    <Setter Property="Foreground" Value="#444441"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                    <Setter Property="Text" Value="Cancelled"/>
                    <Setter Property="Foreground" Value="#791F1F"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <ControlTemplate x:Key="TicketHeader" TargetType="Control">
            <Border Background="#F4F4F4" CornerRadius="6,6,0,0">
                <Grid Margin="12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Ticket" Style="{StaticResource HeaderText}"/>
                    <TextBlock Grid.Column="1" Text="Customer / equipment" Style="{StaticResource HeaderText}"/>
                    <TextBlock Grid.Column="2" Text="Status" Style="{StaticResource HeaderText}"/>
                    <TextBlock Grid.Column="3" Text="Received" Style="{StaticResource HeaderText}"/>
                    <TextBlock Grid.Column="4" Text="Assigned to" Style="{StaticResource HeaderText}"/>
                </Grid>
            </Border>
        </ControlTemplate>

        <DataTemplate x:Key="TicketRow">
            <Border BorderBrush="#EEEEEE" BorderThickness="0,1,0,0">
                <Grid Margin="12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding Id, StringFormat='#{0}'}"
                               Foreground="#777777" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CustomerName}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Foreground="#777777" FontSize="12" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding EquipmentName, Mode=OneWay}"/>
                            <Run Text="·"/>
                            <Run Text="{Binding SerialNumber, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>

                    <Border Grid.Column="2" Style="{StaticResource StatusBadge}">
                        <TextBlock Style="{StaticResource StatusText}"/>
                    </Border>

                    <TextBlock Grid.Column="3" Text="{Binding IntakeDate, StringFormat='{}{0:yyyy.MM.dd}'}"
                               Foreground="#555555" VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="4" Text="{Binding AssignedUserName}"
                               Foreground="#555555" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>

                    <Button Grid.Column="5" Content="Details" Padding="8,3"
                            HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,16,24,24">

            <TextBlock Text="Overview" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding UserLine, FallbackValue='Not signed in'}"
                       Foreground="#777777" Margin="0,2,0,16"/>

            <TextBlock Text="Search customers, equipment or tickets" Margin="0,0,0,4"/>
            <TextBox Style="{StaticResource PlaceholderTextBox}"
                     Tag="Name, phone, serial number or ticket ID"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                     Padding="8,6" FontSize="14"
                     IsEnabled="{Binding IsSignedIn, FallbackValue=False}"/>

            <TextBlock Text="Tickets at a glance" Style="{StaticResource SectionTitle}" Margin="0,24,0,8"/>
            <UniformGrid Columns="4">
                <Border Style="{StaticResource Tile}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Accepted" Style="{StaticResource TileLabel}"/>
                        <TextBlock Text="{Binding AcceptedCount, FallbackValue=0}" Style="{StaticResource TileNumber}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Tile}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Diagnosing" Style="{StaticResource TileLabel}"/>
                        <TextBlock Text="{Binding DiagnosingCount, FallbackValue=0}" Style="{StaticResource TileNumber}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Tile}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="In repair" Style="{StaticResource TileLabel}"/>
                        <TextBlock Text="{Binding InRepairCount, FallbackValue=0}" Style="{StaticResource TileNumber}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Tile}">
                    <StackPanel>
                        <TextBlock Text="Ready for pickup" Style="{StaticResource TileLabel}"/>
                        <TextBlock Text="{Binding FinishedCount, FallbackValue=0}" Style="{StaticResource TileNumber}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Normál nézet: aktív és átvehető ticketek -->
            <StackPanel Style="{StaticResource NormalLists}">
                <Grid Margin="0,24,0,8">
                    <TextBlock Text="{Binding ActiveTitle, FallbackValue='Active tickets'}" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{Binding ActiveTickets.Count, StringFormat='{}{0} tickets', FallbackValue='0 tickets'}"
                               Style="{StaticResource SectionNote}"/>
                </Grid>
                <Border Style="{StaticResource ListFrame}">
                    <StackPanel>
                        <Control Template="{StaticResource TicketHeader}" Focusable="False"/>
                        <ItemsControl x:Name="ActiveList"
                                      ItemsSource="{Binding ActiveTickets}"
                                      ItemTemplate="{StaticResource TicketRow}"
                                      d:ItemsSource="{d:SampleData ItemCount=3}"/>
                        <TextBlock Text="No active tickets.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyText}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasItems, ElementName=ActiveList}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Grid Margin="0,24,0,8">
                    <TextBlock Text="Ready for pickup" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="Call the customer" Style="{StaticResource SectionNote}"/>
                </Grid>
                <Border Style="{StaticResource ListFrame}">
                    <StackPanel>
                        <Control Template="{StaticResource TicketHeader}" Focusable="False"/>
                        <ItemsControl x:Name="ReadyList"
                                      ItemsSource="{Binding ReadyTickets}"
                                      ItemTemplate="{StaticResource TicketRow}"
                                      d:ItemsSource="{d:SampleData ItemCount=2}"/>
                        <TextBlock Text="Nothing is waiting for pickup.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyText}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasItems, ElementName=ReadyList}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Keresés közben: találatok -->
            <StackPanel Style="{StaticResource SearchSection}">
                <Grid Margin="0,24,0,8">
                    <TextBlock Text="Search results" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{Binding SearchResults.Count, StringFormat='{}{0} tickets', FallbackValue='0 tickets'}"
                               Style="{StaticResource SectionNote}"/>
                </Grid>
                <Border Style="{StaticResource ListFrame}">
                    <StackPanel>
                        <Control Template="{StaticResource TicketHeader}" Focusable="False"/>
                        <ItemsControl x:Name="SearchList"
                                      ItemsSource="{Binding SearchResults}"
                                      ItemTemplate="{StaticResource TicketRow}"/>
                        <TextBlock Text="No matching tickets.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyText}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasItems, ElementName=SearchList}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>