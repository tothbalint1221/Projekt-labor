<Window x:Class="ServiceManagerApp.Frontend.PrimaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Service Manager App" Height="650" Width="1100"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#F4F4F4" BorderBrush="#CCCCCC" BorderThickness="0,0,1,0">
            <StackPanel Margin="10">
                <TextBlock Text="Service Manager" FontWeight="Bold" FontSize="14" Margin="0,5,0,15" HorizontalAlignment="Center"/>

                <Button Content="OverView" Margin="0,4" Padding="8,6" Click="BtnNav_Click" Tag="OverView"/>
                <Button Content="Tickets" Margin="0,4" Padding="8,6" Click="BtnNav_Click" Tag="Tickets"/>
                <Button Content="Customers" Margin="0,4" Padding="8,6" Click="BtnNav_Click" Tag="Customers"/>
                <Button Content="Equipments" Margin="0,4" Padding="8,6" Click="BtnNav_Click" Tag="Equipments"/>
                <Button Content="Parts" Margin="0,4" Padding="8,6" Click="BtnNav_Click" Tag="Parts"/>
                <Button Content="Users" Margin="0,4" Padding="8,6" Click="BtnNav_Click" Tag="Users"/>
            </StackPanel>
        </Border>

        <ContentControl x:Name="MainContentArea" Grid.Column="1" Margin="10"/>
    </Grid>
</Window>