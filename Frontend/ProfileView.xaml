<UserControl x:Class="ServiceManagerApp.Frontend.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ServiceManagerApp.Frontend"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="White"
             Foreground="Black">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Név és szerepkör -->
        <Border BorderBrush="#AAAAAA"
            BorderThickness="1"
            Padding="16"
            Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="txtProfileName"
                       Text="Felhasználó neve"
                       FontSize="20"
                       FontWeight="SemiBold"/>

                <TextBlock x:Name="txtProfileRole"
                       Text="Szerepkör"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Jelszócsere -->
            <Border Grid.Column="0"
                BorderBrush="#AAAAAA"
                BorderThickness="1"
                Padding="16">
                <StackPanel>
                    <TextBlock Text="Change password"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,18"/>

                    <Label Content="Current password"
                       Target="{Binding ElementName=txtCurrentPassword}"
                       Padding="0"
                       Margin="0,0,0,6"/>

                    <PasswordBox x:Name="txtCurrentPassword"
                             Padding="6"
                             Margin="0,0,0,14"/>

                    <Label Content="New password"
                       Target="{Binding ElementName=txtNewPassword}"
                       Padding="0"
                       Margin="0,0,0,6"/>

                    <PasswordBox x:Name="txtNewPassword"
                             Padding="6"
                             Margin="0,0,0,14"/>

                    <Label Content="Confirm new password"
                       Target="{Binding ElementName=txtConfirmPassword}"
                       Padding="0"
                       Margin="0,0,0,6"/>

                    <PasswordBox x:Name="txtConfirmPassword"
                             Padding="6"
                             Margin="0,0,0,20"/>

                    <Button x:Name="btnSavePassword"
                        Content="Save password"
                        Background="#008000"
                        Foreground="White"
                        Padding="8"/>
                </StackPanel>
            </Border>

            <!-- Saját adatok és kijelentkezés -->
            <Border Grid.Column="2"
                BorderBrush="#AAAAAA"
                BorderThickness="1"
                Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="My details"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,0,0,18"/>

                        <TextBlock Text="Email"/>
                        <TextBlock x:Name="txtProfileEmail"
                               Text="—"
                               TextWrapping="Wrap"
                               Margin="0,6,0,16"/>

                        <TextBlock Text="Phone"/>
                        <TextBlock x:Name="txtProfilePhone"
                               Text="—"
                               TextWrapping="Wrap"
                               Margin="0,6,0,16"/>

                        <TextBlock Text="Address"/>
                        <TextBlock x:Name="txtProfileAddress"
                               Text="—"
                               TextWrapping="Wrap"
                               Margin="0,6,0,16"/>
                    </StackPanel>

                    <Button x:Name="btnSignOut"
                        Grid.Row="1"
                        Content="Sign out"
                        Background="#F08080"
                        Padding="8"
                        Margin="0,20,0,0"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
