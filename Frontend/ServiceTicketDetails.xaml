<Window x:Class="ServiceManagerApp.Frontend.ServiceTicketDetails"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Service Ticket Details" Height="760" Width="720"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Ticket Details"
                   FontSize="20" FontWeight="SemiBold" Margin="0,0,0,20"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Id:" FontWeight="SemiBold" Margin="0,0,16,12"/>
        <TextBlock x:Name="txtTicketId" Grid.Row="1" Grid.Column="1" Margin="0,0,0,12"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Equipment:" FontWeight="SemiBold" Margin="0,0,16,12"/>
        <TextBlock x:Name="txtEquipment" Grid.Row="2" Grid.Column="1" Margin="0,0,0,12"
                   TextWrapping="Wrap"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Assigned To:" FontWeight="SemiBold" Margin="0,0,16,12"/>
        <TextBlock x:Name="txtAssignedTo" Grid.Row="3" Grid.Column="1" Margin="0,0,0,12"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Labor Cost:" FontWeight="SemiBold" Margin="0,0,16,12" VerticalAlignment="Center"/>
        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
            <Button Content="OK" Click="BtnSaveLaborCost_Click" Margin="0,0,8,0" Padding="10,2"/>
            <TextBox x:Name="txtCost" Width="180" VerticalAlignment="Center"/>
        </StackPanel>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Final Price:" FontWeight="SemiBold" Margin="0,0,16,12"/>
        <TextBlock x:Name="txtPrice" Grid.Row="5" Grid.Column="1" Margin="0,0,0,12"/>

        <TextBlock Grid.Row="6" Grid.Column="0" Text="Status:" FontWeight="SemiBold" Margin="0,0,16,12"/>
        <ComboBox x:Name="cmbStatus" Grid.Row="6" Grid.Column="1" Margin="0,0,0,12"
                  MinWidth="180" HorizontalAlignment="Left"
                  SelectionChanged="CmbStatus_SelectionChanged"/>

        <DataGrid x:Name="dataGridFaults" Grid.Row="7" Grid.ColumnSpan="2" Margin="5"
                  CanUserAddRows="False" AutoGenerateColumns="False"
                  HeadersVisibility="Column" RowHeaderWidth="0" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding FaultName}" Width="1.1*"/>

                <DataGridTextColumn Header="Diagnosis" Binding="{Binding Diagnosis}" Width="1.4*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Repairs" Binding="{Binding Repairs}" Width="1.4*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTemplateColumn Header="Status" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox Width="128" HorizontalAlignment="Center"
                                      ItemsSource="{Binding StatusOptions, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                      SelectedItem="{Binding Status, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      SelectionChanged="CmbFaultStatus_SelectionChanged">
                            </ComboBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="" Width="42">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="X" Width="28" Height="26" Padding="0"
                                    Click="BtnDeleteFaultAsync"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="8" Grid.ColumnSpan="2" Margin="5,8">
            <TextBlock Text="Add Fault" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                    <TextBlock Text="Name"/>
                    <TextBox x:Name="txtFaultName" ToolTip="Fault name"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,6,0">
                    <TextBlock Text="Diagnosis"/>
                    <TextBox x:Name="txtDiagnosis" ToolTip="Diagnosis"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Repairs"/>
                    <TextBox x:Name="txtRepairs" ToolTip="Repairs"/>
                </StackPanel>
            </Grid>
            <Button x:Name="btnAddFault" Content="Add Fault" Click="BtnAddFaultAsync" Padding="12,6"
                    HorizontalAlignment="Right" Margin="0,8,0,0"/>
        </StackPanel>

        <DataGrid x:Name="dataGridTicketParts" Grid.Row="9" Grid.ColumnSpan="2" Margin="5" CanUserAddRows="False" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Part.PartName}" Width="*"/>
                <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="*"/>
                <DataGridTextColumn Header="Unit Price" Binding="{Binding UnitPrice, StringFormat={}{0:C}}" Width="*"/>

                <DataGridTemplateColumn Header="" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="+" Click="BtnIncrementQuantityAsync"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="-" Click="BtnDecrementQuantityAsync"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="X" Click="BtnRemovePartFromTicketAsync"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="10" Grid.ColumnSpan="2" Margin="5,8">
            <TextBlock Text="Assign Part" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Part"/>
                    <ComboBox x:Name="cmbParts" SelectedValuePath="Id" MinWidth="0">
                        <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Id, StringFormat='[#{0}] '}"/>
                                <TextBlock Text="{Binding PartName, StringFormat='[{0}] '}"/>
                                <TextBlock Text="{Binding Quantity}"/>
                            </StackPanel>
                        </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Quantity"/>
                    <TextBox x:Name="txtQuantity" ToolTip="Quantity"/>
                </StackPanel>

            </Grid>
            <Button x:Name="btnAddPart" Content="Add Part" Click="BtnAddTicketPart" Padding="12,6"
                    HorizontalAlignment="Right" Margin="0,8,0,0"/>
        </StackPanel>
    </Grid>
</Window>